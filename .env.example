REPORT_AI_DB_NAME=report_ai
REPORT_AI_DB_USERNAME=report_ai
REPORT_AI_DB_PASSWORD=change-me-for-local-development
REPORT_AI_DB_PORT=5432
REPORT_AI_LLM_ENABLED=false
REPORT_AI_LLM_PROVIDER=xfcxb
REPORT_AI_LLM_ENDPOINT=https://llmapi.xfcxb.com/v1
REPORT_AI_LLM_MODEL=gpt-5.6-terra
REPORT_AI_LLM_REASONING_EFFORT=high
REPORT_AI_LLM_CODER_REASONING_EFFORT=medium
REPORT_AI_LLM_CODER_FALLBACK_REASONING_EFFORT=low
REPORT_AI_LLM_CODER_FALLBACK_ENABLED=true
REPORT_AI_LLM_CODER_MAX_OUTPUT_TOKENS=4096
REPORT_AI_LLM_CODER_TIMEOUT=PT105S
REPORT_AI_LLM_VISION_MAX_ATTACHMENTS=16
REPORT_AI_LLM_VISION_MAX_ATTACHMENT_BYTES=20971520
REPORT_AI_LLM_VISION_MAX_ATTACHMENT_TOTAL_BYTES=41943040
REPORT_AI_LLM_READ_TIMEOUT=PT180S
REPORT_AI_LLM_API_KEY=replace-with-provider-key
REPORT_AI_RUNTIME_ENABLED=false
REPORT_AI_RUNTIME_CAPABILITIES=python:3.12-slim; standard-library only; network disabled; tenant-approved task inputs and DOCX embedded assets are mounted read-only under /workspace/input; entry point receives no CLI arguments
REPORT_AI_RUNTIME_CATALOG_ENABLED=false
REPORT_AI_RUNTIME_CATALOG_PATH=runtime-images/scientific/local-catalog/scientific.catalog.json
REPORT_AI_RUNTIME_CATALOG_SIGNATURE_PATH=runtime-images/scientific/local-catalog/scientific.catalog.sig
REPORT_AI_RUNTIME_CATALOG_PUBLIC_KEY_PATH=runtime-images/scientific/local-catalog/catalog-ed25519-public.pem
REPORT_AI_RUNTIME_IMAGE_PULL_ENABLED=false
REPORT_AI_RUNTIME_MAX_INPUT_BYTES=536870912
# To run the checked-in local scientific profile after loading its digest-pinned
# image into Docker, set both flags below to true. Catalog verification fails
# closed if any path, signature, or image digest is unavailable.
# REPORT_AI_RUNTIME_ENABLED=true
# REPORT_AI_RUNTIME_CATALOG_ENABLED=true
REPORT_AI_SMTP_HOST=smtp.qq.com
REPORT_AI_SMTP_PORT=465
REPORT_AI_SMTP_USERNAME=replace-with-qq-mailbox
REPORT_AI_SMTP_PASSWORD=replace-with-qq-authorization-code
REPORT_AI_AUTH_EMAIL_ENABLED=false
REPORT_AI_AUTH_EMAIL_FROM=replace-with-qq-mailbox
REPORT_AI_AUTH_RATE_LIMIT_BACKEND=memory
REPORT_AI_AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
REPORT_AI_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# REPORT_AI_AUTH_RATE_LIMIT_BACKEND=redis
